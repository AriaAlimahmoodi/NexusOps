{
  "name": "@n8n/task-runner",
  "version": "2.45.5",
  "main": "dist/start.js",
  "module": "src/start.ts",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "LICENSE.md",
    "LICENSE_EE.md"
  ],
  "exports": {
    "./start": {
      "types": "./dist/start.d.ts",
      "require": "./dist/start.js",
      "import": "./src/start.ts"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./src/index.ts"
    }
  },
  "dependencies": {
    "@n8n/config": "2.43.2",
    "@n8n/di": "0.17.0",
    "@n8n/utils": "1.52.1",
    "@sentry/core": "10.70.0",
    "acorn": "8.14.0",
    "acorn-walk": "8.3.4",
    "lodash": "4.18.1",
    "luxon": "3.7.2",
    "n8n-core": "2.45.5",
    "n8n-workflow": "2.45.3",
    "nanoid": "3.3.18",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@n8n/eslint-config": "0.0.1",
    "@n8n/oxlint-config": "0.0.1",
    "@n8n/typescript-config": "1.12.0",
    "@n8n/vitest-config": "1.24.0",
    "@types/lodash": "4.17.17",
    "@types/luxon": "3.2.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "5.0.1",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "^0.21.1",
    "typescript": "7.0.2",
    "vite": "^8.0.2",
    "vitest": "5.0.1",
    "vitest-mock-extended": "^3.1.0"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://n8n.io",
  "author": {
    "name": "Jan Oberhauser",
    "email": "jan@n8n.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n8n-io/n8n.git"
  },
  "scripts": {
    "clean": "rimraf dist .turbo",
    "start": "node dist/start.js",
    "dev": "pnpm build && pnpm start",
    "debug": "./scripts/debug.sh",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p ./tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:unchecked": "tsc -p ./tsconfig.build.json --noCheck && tsc-alias -p tsconfig.build.json",
    "format": "biome format --write src",
    "format:check": "biome ci src",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:dev": "vitest --silent=false",
    "lint": "oxlint --quiet",
    "lint:fix": "oxlint --fix",
    "watch": "tsc-watch -p tsconfig.build.json --onCompilationComplete \"tsc-alias -p tsconfig.build.json\""
  }
}