{
  "name": "@n8n/utils",
  "type": "module",
  "version": "1.52.1",
  "files": [
    "dist",
    "LICENSE.md",
    "LICENSE_EE.md"
  ],
  "exports": {
    "./dist/*": {
      "types": "./dist/*.d.mts",
      "import": "./dist/*.mjs",
      "require": "./dist/*.cjs"
    },
    "./*": {
      "types": "./dist/*.d.mts",
      "import": "./dist/*.mjs",
      "require": "./dist/*.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*.d.cts"
      ]
    }
  },
  "dependencies": {
    "@n8n/constants": "0.43.1",
    "nanoid": "3.3.18",
    "semver": "7.7.3"
  },
  "devDependencies": {
    "@n8n/oxlint-config": "0.0.1",
    "@n8n/typescript-config": "1.12.0",
    "@n8n/vitest-config": "1.24.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/semver": "^7.7.0",
    "fast-check": "^3.23.2",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "^0.21.1",
    "tsdown": "^0.22.8",
    "typescript": "7.0.2",
    "vite": "^8.0.2",
    "vitest": "5.0.1"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://n8n.io",
  "author": {
    "name": "Jan Oberhauser",
    "email": "jan@n8n.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n8n-io/n8n.git"
  },
  "scripts": {
    "clean": "rimraf dist .turbo",
    "dev": "tsdown --watch",
    "build": "tsdown",
    "build:unchecked": "pnpm run build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:dev": "vitest --silent=false",
    "lint": "oxlint src --quiet",
    "lint:fix": "oxlint src --fix",
    "format": "biome format --write . && prettier --write . --ignore-path ../../../.prettierignore",
    "format:check": "biome ci . && prettier --check . --ignore-path ../../../.prettierignore"
  }
}