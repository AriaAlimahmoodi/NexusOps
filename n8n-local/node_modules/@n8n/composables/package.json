{
  "name": "@n8n/composables",
  "type": "module",
  "version": "1.35.5",
  "files": [
    "dist",
    "LICENSE_EE.md",
    "LICENSE.md"
  ],
  "exports": {
    "./*": {
      "types": "./dist/*.d.mts",
      "import": "./dist/*.mjs",
      "require": "./dist/*.cjs"
    }
  },
  "dependencies": {
    "@n8n/api-types": "1.45.5",
    "@n8n/frontend-constants": "0.11.0",
    "@n8n/frontend-utils": "0.4.0",
    "@n8n/i18n": "2.45.5",
    "@vueuse/core": "^14.3.0",
    "lodash": "4.18.1",
    "n8n-workflow": "2.45.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@n8n/eslint-config": "0.0.1",
    "@n8n/playwright-janitor": "0.1.0",
    "@n8n/telemetry": "1.13.5",
    "@n8n/typescript-config": "1.12.0",
    "@n8n/vitest-config": "1.24.0",
    "@pinia/testing": "^0.1.6",
    "element-plus": "2.4.3",
    "@testing-library/vue": "^8.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash": "4.17.17",
    "pinia": "^2.2.4",
    "tsdown": "^0.16.5",
    "typescript": "6.0.2",
    "vite": "^8.0.2",
    "vitest": "5.0.1",
    "vue-tsc": "^2.2.8"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://n8n.io",
  "author": {
    "name": "Jan Oberhauser",
    "email": "jan@n8n.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n8n-io/n8n.git"
  },
  "scripts": {
    "clean": "rimraf dist .turbo",
    "dev": "tsdown --watch",
    "build": "tsdown",
    "build:unchecked": "pnpm run build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:changed": "janitor test-scoped",
    "test:dev": "vitest --silent=false",
    "lint": "eslint src --quiet",
    "lint:fix": "eslint src --fix",
    "format": "biome format --write . && prettier --write . --ignore-path ../../../../.prettierignore",
    "format:check": "biome ci . && prettier --check . --ignore-path ../../../../.prettierignore"
  }
}