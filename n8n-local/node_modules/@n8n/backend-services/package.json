{
  "name": "@n8n/backend-services",
  "version": "1.5.5",
  "main": "dist/index.js",
  "module": "src/index.ts",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "module": "./src/auth.ts",
      "default": "./dist/auth.js"
    }
  },
  "files": [
    "dist/**/*",
    "LICENSE.md",
    "LICENSE_EE.md"
  ],
  "dependencies": {
    "@n8n/api-types": "1.45.5",
    "@n8n/backend-common": "1.45.5",
    "@n8n/backend-network": "1.19.5",
    "@n8n/config": "2.43.2",
    "@n8n/constants": "0.43.1",
    "@n8n/db": "1.45.5",
    "@n8n/decorators": "1.45.5",
    "@n8n/di": "0.17.0",
    "@n8n/errors": "0.15.0",
    "@n8n/inbound-auth": "0.4.3",
    "@n8n/permissions": "0.82.0",
    "@n8n/utils": "1.52.1",
    "cache-manager": "5.2.3",
    "ioredis": "5.3.2",
    "jose": "^6.2.9",
    "jsonwebtoken": "9.0.3",
    "n8n-core": "2.45.5",
    "n8n-workflow": "2.45.3"
  },
  "peerDependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@n8n/backend-test-utils": "1.45.5",
    "@n8n/eslint-config": "0.0.1",
    "@n8n/oxlint-config": "0.0.1",
    "@n8n/typescript-config": "1.12.0",
    "@n8n/vitest-config": "1.24.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/lodash": "4.17.17",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "9.29.0",
    "ioredis-mock": "^8.8.1",
    "lodash": "4.18.1",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "^0.21.1",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "vitest-mock-extended": "^3.1.0",
    "zod": "3.25.76"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://n8n.io",
  "author": {
    "name": "Jan Oberhauser",
    "email": "jan@n8n.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n8n-io/n8n.git"
  },
  "scripts": {
    "clean": "rimraf dist .turbo",
    "dev": "pnpm watch",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "build:unchecked": "tsc -p tsconfig.build.json --noCheck",
    "format": "biome format --write .",
    "format:check": "biome ci .",
    "lint": "oxlint --quiet",
    "lint:fix": "oxlint --fix",
    "watch": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "test:dev": "vitest --silent=false"
  }
}