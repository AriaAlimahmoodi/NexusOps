    "zod": "3.25.76"
  },
  "devDependencies": {
    "@n8n/oxlint-config": "0.0.1",
    "@n8n/typescript-config": "1.12.0",
    "@n8n/vitest-config": "1.24.0",
    "@vitest/coverage-v8": "5.0.1",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "^0.21.1",
    "typescript": "7.0.2",
    "vite": "^8.0.2",
    "vitest": "5.0.1"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://n8n.io",
