{
  "name": "@n8n/instance-ai",
  "version": "1.30.5",
  "main": "dist/index.js",
  "module": "src/index.ts",
  "types": "dist/index.d.ts",
  "files": [
    "assets/workflow-diagnostics.mts",
    "dist/**/*",
    "knowledge-base/**/*",
    "skills/**/*",
    "LICENSE.md",
    "LICENSE_EE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "require": "./dist/errors/index.js",
      "import": "./dist/errors/index.js"
    },
    "./parsers": {
      "require": "./dist/parsers/index.js",
      "import": "./dist/parsers/index.js",
      "types": "./dist/parsers/index.d.ts"
    },
    "./confirmation-payload": {
      "require": "./dist/runtime/confirmation-payload.js",
      "import": "./dist/runtime/confirmation-payload.js",
      "types": "./dist/runtime/confirmation-payload.d.ts"
    },
    "./evaluations": "./evaluations/index.ts"
  },
  "typesVersions": {
    "*": {
      "errors": [
        "dist/errors/index.d.ts"
      ],
      "parsers": [
        "dist/parsers/index.d.ts"
      ],
      "confirmation-payload": [
        "dist/runtime/confirmation-payload.d.ts"
      ]
    }
  },
  "dependencies": {
    "@daytona/sdk": "0.205.1",
    "@e965/xlsx": "0.20.3",
    "@n8n/agents": "0.30.5",
    "@n8n/ai-utilities": "0.38.5",
    "@n8n/api-types": "1.45.5",
    "@n8n/mcp-browser": "0.25.1",
    "@n8n/utils": "1.52.1",
    "@n8n/workflow-sdk": "0.38.3",
    "@opentelemetry/api": "1.9.1",
    "@thednp/dommatrix": "^3.1.1",
    "ai": "^7.0.66",
    "csv-parse": "7.0.2",
    "langsmith": "0.6.0",
    "linkedom": "^0.18.13",
    "luxon": "3.7.2",
    "mammoth": "1.12.1",
    "n8n-workflow": "2.45.3",
    "nanoid": "6.0.1",
    "pdf-parse": "2.4.5",
    "psl": "1.15.0",
    "source-map-support": "0.5.21",
    "turndown": "^7.2.4",
    "zod": "3.25.76",
    "zod-from-json-schema-v3": "npm:zod-from-json-schema@^0.0.5"
  },
  "devDependencies": {
    "@langchain/anthropic": "1.5.6",
    "@langchain/core": "1.2.8",
    "@n8n/oxlint-config": "0.0.1",
    "@n8n/typescript-config": "1.12.0",
    "@n8n/vitest-config": "1.24.0",
    "@types/luxon": "3.2.0",
    "@types/psl": "1.1.3",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "5.0.1",
    "fast-glob": "3.3.3",
    "p-limit": "^7.3.1",
    "playwright-core": "1.62.1",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "^0.21.1",
    "tsx": "^4.19.3",
    "typescript": "7.0.2",
    "undici": "^7.29.1",
    "vite": "^8.0.2",
    "vitest": "5.0.1",
    "vitest-mock-extended": "^3.1.0"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://n8n.io",
  "author": {
    "name": "Jan Oberhauser",
    "email": "jan@n8n.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n8n-io/n8n.git"
  },
  "scripts": {
    "clean": "rimraf dist .turbo",
    "typecheck": "tsc --noEmit && tsc -p evaluations/tsconfig.json",
    "build": "tsc -p ./tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:unchecked": "tsc -p ./tsconfig.build.json --noCheck && tsc-alias -p tsconfig.build.json",
    "format": "biome format --write src assets",
    "format:check": "biome ci src assets",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:dev": "vitest --silent=false",
    "lint": "oxlint --quiet",
    "lint:fix": "oxlint --fix",
    "eval:instance-ai": "tsx evaluations/cli/index.ts",
    "eval:agents": "tsx evaluations/cli/index.ts --source langtracer --suite agents --tier agents",
    "eval:build-mcp-manifest": "tsx evaluations/cli/build-mcp-manifest.ts",
    "eval:langtracer-push": "tsx evaluations/cli/langtracer-push.ts",
    "eval:serve-fixture": "tsx evaluations/cli/serve-fixture.ts",
    "eval:pairwise": "tsx evaluations/cli/pairwise.ts",
    "eval:pairwise:report": "tsx evaluations/cli/report.ts",
    "eval:pairwise:compare": "tsx evaluations/cli/compare-pairwise.ts",
    "eval:subagent": "tsx evaluations/subagent/cli.ts",
    "eval:computer-use": "tsx evaluations/computer-use/cli.ts",
    "eval:discovery": "tsx evaluations/discovery/cli.ts",
    "prompts:print": "tsx scripts/print-prompts.ts"
  }
}