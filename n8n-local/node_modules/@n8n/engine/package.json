{
  "name": "@n8n/engine",
  "version": "0.25.2",
  "description": "n8n workflow execution engine (v2)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "LICENSE.md",
    "LICENSE_EE.md"
  ],
  "dependencies": {
    "@n8n/config": "2.43.2",
    "@n8n/constants": "0.43.1",
    "@n8n/di": "0.17.0",
    "@n8n/typeorm": "0.12.0",
    "@n8n/utils": "1.52.1",
    "express": "5.1.0",
    "jsonwebtoken": "9.0.3",
    "pg": "8.21.0",
    "reflect-metadata": "0.2.2",
    "uuid": "11.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@n8n/eslint-config": "0.0.1",
    "@n8n/oxlint-config": "0.0.1",
    "@n8n/typescript-config": "1.12.0",
    "@n8n/vitest-config": "1.24.0",
    "@testcontainers/postgresql": "^11.13.0",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "9.0.10",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "n8n-containers": "1.0.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "^0.21.1",
    "supertest": "^7.1.1",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://n8n.io",
  "author": {
    "name": "Jan Oberhauser",
    "email": "jan@n8n.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n8n-io/n8n.git"
  },
  "scripts": {
    "clean": "rimraf dist .turbo compiled",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "build:unchecked": "tsc -p tsconfig.build.json --noCheck",
    "build:docker": "pnpm build && rimraf compiled && DOCKER_BUILD=true NODE_ENV=production pnpm --filter . --prod --config.inject-workspace-packages=true --config.package-import-method=copy deploy --no-optional compiled && rimraf compiled/pnpm-lock.yaml compiled/pnpm-workspace.yaml compiled/node_modules/.pnpm-workspace-state-v1.json && docker build -f ../../../docker/images/engine/Dockerfile -t n8n-engine:local .",
    "start": "node dist/serve.js",
    "format": "biome format --write src",
    "format:check": "biome ci src",
    "lint": "oxlint --quiet",
    "lint:fix": "oxlint --fix",
    "test": "vitest run --passWithNoTests",
    "test:dev": "vitest --watch",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "watch": "tsc -p tsconfig.build.json --watch"
  }
}