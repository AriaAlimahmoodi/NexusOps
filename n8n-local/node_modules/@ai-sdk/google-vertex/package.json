{
  "name": "@ai-sdk/google-vertex",
  "version": "5.0.127",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*",
    "docs/**/*",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts",
    "!src/**/__snapshots__",
    "!src/**/__fixtures__",
    "CHANGELOG.md",
    "README.md",
    "edge.d.ts",
    "anthropic/edge.d.ts",
    "anthropic/index.d.ts",
    "maas/edge.d.ts",
    "maas/index.d.ts",
    "xai/edge.d.ts",
    "xai/index.d.ts"
  ],
  "directories": {
    "doc": "./docs"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./edge": {
      "types": "./dist/edge/index.d.ts",
      "import": "./dist/edge/index.js",
      "default": "./dist/edge/index.js"
    },
    "./anthropic": {
      "types": "./dist/anthropic/index.d.ts",
      "import": "./dist/anthropic/index.js",
      "default": "./dist/anthropic/index.js"
    },
    "./anthropic/edge": {
      "types": "./dist/anthropic/edge/index.d.ts",
      "import": "./dist/anthropic/edge/index.js",
      "default": "./dist/anthropic/edge/index.js"
    },
    "./maas": {
      "types": "./dist/maas/index.d.ts",
      "import": "./dist/maas/index.js",
      "default": "./dist/maas/index.js"
    },
    "./maas/edge": {
      "types": "./dist/maas/edge/index.d.ts",
      "import": "./dist/maas/edge/index.js",
      "default": "./dist/maas/edge/index.js"
    },
    "./xai": {
      "types": "./dist/xai/index.d.ts",
      "import": "./dist/xai/index.js",
      "default": "./dist/xai/index.js"
    },
    "./xai/edge": {
      "types": "./dist/xai/edge/index.d.ts",
      "import": "./dist/xai/edge/index.js",
      "default": "./dist/xai/edge/index.js"
    }
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.92",
    "@ai-sdk/google": "4.0.108",
    "@ai-sdk/openai-compatible": "3.0.81",
    "@ai-sdk/provider": "4.0.34",
    "@ai-sdk/provider-utils": "5.0.71",
    "google-auth-library": "^11.3.1"
  },
  "devDependencies": {
    "@ai-sdk/test-server": "2.0.4",
    "@types/node": "22.19.19",
    "@vercel/ai-tsconfig": "0.0.0",
    "@vercel/ai-tsdown-config": "0.0.0",
    "tsdown": "^0.23.0",
    "typescript": "6.0.3",
    "zod": "3.25.76"
  },
  "peerDependencies": {
    "zod": "^3.25.76 || ^4.1.8"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://ai-sdk.dev/docs",
  "repository": {
    "type": "git",
    "url": "https://github.com/vercel/ai",
    "directory": "packages/google-vertex"
  },
  "bugs": {
    "url": "https://github.com/vercel/ai/issues"
  },
  "keywords": [
    "ai"
  ],
  "scripts": {
    "build": "pnpm clean && tsdown",
    "build:watch": "pnpm clean && tsdown --watch",
    "clean": "del-cli docs *.tsbuildinfo",
    "type-check": "tsc --build",
    "test": "pnpm test:node && pnpm test:edge",
    "test:update": "pnpm test:node -u",
    "test:watch": "vitest --config vitest.node.config.js",
    "test:edge": "vitest --config vitest.edge.config.js --run",
    "test:node": "vitest --config vitest.node.config.js --run"
  }
}