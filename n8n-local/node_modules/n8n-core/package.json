{
  "name": "n8n-core",
  "version": "2.45.5",
  "description": "Core functionality of n8n",
  "main": "dist/index",
  "types": "dist/index.d.ts",
  "bin": {
    "n8n-copy-static-files": "./bin/copy-static-files",
    "n8n-generate-translations": "./bin/generate-translations",
    "n8n-generate-metadata": "./bin/generate-metadata",
    "n8n-generate-node-defs": "./bin/generate-node-defs"
  },
  "files": [
    "dist",
    "bin",
    "LICENSE.md",
    "LICENSE_EE.md"
  ],
  "devDependencies": {
    "@n8n/eslint-config": "0.0.1",
    "@n8n/oxlint-config": "0.0.1",
    "@n8n/playwright-janitor": "0.1.0",
    "@n8n/typescript-config": "1.12.0",
    "@n8n/typeorm": "0.12.0",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "9.0.10",
    "@types/lodash": "4.17.17",
    "@types/luxon": "3.2.0",
    "@types/mime-types": "3.0.1",
    "@types/ms": "2.1.0",
    "@types/ssh2": "1.15.0",
    "@types/uuid": "^11.0.0",
    "@n8n/vitest-config": "1.24.0",
    "@vitest/coverage-istanbul": "5.0.1",
    "@vitest/coverage-v8": "5.0.1",
    "axios": "1.20.0",
    "nock": "14.0.14",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "^0.21.1",
    "reflect-metadata": "0.2.2",
    "typescript": "7.0.2",
    "vite": "^8.0.2",
    "vitest": "5.0.1",
    "vitest-mock-extended": "^3.1.0",
    "zod": "3.25.76"
  },
  "peerDependencies": {
    "zod": "3.25.76"
  },
  "dependencies": {
    "@langchain/core": "1.2.8",
    "@n8n/backend-common": "1.45.5",
    "@n8n/backend-network": "1.19.5",
    "@n8n/blob-storage": "1.13.5",
    "@n8n/client-oauth2": "1.27.5",
    "@n8n/config": "2.43.2",
    "@n8n/constants": "0.43.1",
    "@n8n/decorators": "1.45.5",
    "@n8n/di": "0.17.0",
    "@n8n/errors": "0.15.0",
    "@n8n/utils": "1.52.1",
    "@n8n/workflow-sdk": "0.38.3",
    "@sentry/core": "10.70.0",
    "@sentry/node": "10.70.0",
    "@sentry/node-native": "10.70.0",
    "@sentry/profiling-node": "10.70.0",
    "callsites": "3.1.0",
    "chardet": "2.0.0",
    "cron": "4.4.0",
    "fast-glob": "3.3.3",
    "file-type": "21.3.3",
    "form-data": "4.0.6",
    "jsonwebtoken": "9.0.3",
    "lodash": "4.18.1",
    "luxon": "3.7.2",
    "mime-types": "3.0.2",
    "ms": "2.1.3",
    "n8n-workflow": "2.45.3",
    "nanoid": "3.3.18",
    "oauth-1.0a": "2.2.6",
    "p-cancelable": "2.1.1",
    "p-limit": "^3.1.0",
    "pretty-bytes": "5.6.0",
    "ssh2": "1.15.0",
    "uuid": "11.1.1"
