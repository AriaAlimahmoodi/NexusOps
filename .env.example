ELASTICSEARCH_URL=https://127.0.0.1:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=replace_with_your_password

# Global labor-market API connectors (read-only; no automatic Elasticsearch writes)
ESCO_API_BASE_URL=https://ec.europa.eu/esco/api
REMOTIVE_API_BASE_URL=https://remotive.com/api

# Legacy U.S. public-data connectors (retained for optional use)
COLLEGE_SCORECARD_API_KEY=replace_with_your_college_scorecard_key
BLS_API_VERSION=1
# Required only when BLS_API_VERSION=2
BLS_REGISTRATION_KEY=
